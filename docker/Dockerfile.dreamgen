# DreamGen Backend Image (Two-Pod Architecture)
# =============================================
# Lightweight image with the generation orchestrator.
# Connects to ComfyUI server over HTTP (in separate pod).
# Changes frequently - keep layers small for fast iteration.
#
# MODES:
# - serverless (default): Single container with local ComfyUI
# - pod: Discovers ComfyUI from VPS registry, long-running process
#
# Build:
#   docker build -f docker/Dockerfile.dreamgen -t luxiasl/dreamgen-backend:latest .
#   docker push luxiasl/dreamgen-backend:latest
#
# Run in POD mode (two-pod architecture):
#   docker run --gpus all \
#     -e DREAMGEN_MODE=pod \
#     -e VPS_WEBSOCKET_URL=wss://aetherawi.red/ws/gpu \
#     -e VPS_API_URL=https://aetherawi.red \
#     -e DREAM_GEN_AUTH_TOKEN=your-shared-token \
#     luxiasl/dreamgen-backend:latest
#
# Environment Variables (Pod Mode):
#   DREAMGEN_MODE          - Set to "pod" for two-pod architecture
#   VPS_WEBSOCKET_URL      - WebSocket URL for frame streaming
#   VPS_API_URL            - HTTP URL for ComfyUI discovery
#   DREAM_GEN_AUTH_TOKEN   - Shared auth token with VPS
#
# Environment Variables (Serverless Mode - legacy):
#   VPS_WEBSOCKET_URL      - WebSocket URL for frame streaming
#   DREAM_GEN_AUTH_TOKEN   - Shared auth token with VPS

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# System dependencies (minimal)
# Note: libgl1-mesa-glx was renamed to libgl1 in Debian Trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies (cached layer)
COPY pyproject.toml /app/
RUN pip install --no-cache-dir \
    websockets \
    msgpack \
    pillow \
    numpy \
    pyyaml \
    aiohttp \
    runpod \
    imagehash \
    scikit-image \
    diffusers \
    huggingface-hub \
    accelerate \
    torch --index-url https://download.pytorch.org/whl/cu121

# Copy backend code
COPY backend/ /app/backend/

# Copy prompts (CRITICAL for infinite gen!)
COPY prompts/ /app/prompts/

# Optional: Copy seeds for backwards compatibility
# (Fresh frame generation is preferred for startup)
COPY seeds/ /app/seeds/

# Create output directories
RUN mkdir -p /app/output/keyframes /app/output/interpolations /app/output/frames/fresh \
    /app/cache /app/logs /app/state

# Build info
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown
RUN echo "BUILD_DATE=${BUILD_DATE}" > /app/BUILD_INFO && \
    echo "GIT_COMMIT=${GIT_COMMIT}" >> /app/BUILD_INFO

# Environment
ENV PYTHONPATH=/app:/app/backend
ENV LOG_LEVEL=INFO
ENV CONFIG_PATH=/app/backend/config.cloud.yaml

# Default mode - set to "pod" for two-pod architecture
# Serverless mode is legacy (combined ComfyUI + DreamGen in one container)
ENV DREAMGEN_MODE=serverless

# VPS connection (set at runtime)
# ENV VPS_WEBSOCKET_URL=wss://aetherawi.red/ws/gpu
# ENV VPS_API_URL=https://aetherawi.red
# ENV DREAM_GEN_AUTH_TOKEN=<set-at-runtime>

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "print('healthy')" || exit 1

# Entry point handles both serverless and pod modes based on DREAMGEN_MODE
CMD ["python", "-m", "backend.cloud.runpod_handler"]

