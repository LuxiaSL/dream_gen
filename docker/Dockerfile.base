# Dream Window Base Image
# =======================
# Contains: CUDA, Python, ComfyUI, SD 1.5 model, pip dependencies
# This image rarely changes (~4GB), so it's built separately.
#
# Build:
#   docker build -f docker/Dockerfile.base -t luxiasl/dreamgen-base:latest .
#   docker push luxiasl/dreamgen-base:latest
#
# Usage:
#   The main Dockerfile.cloud inherits FROM this image.

# ==================== Base Stage ====================
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    git \
    curl \
    wget \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Create app user
RUN useradd -m -s /bin/bash dreamgen
WORKDIR /app

# ==================== ComfyUI Stage ====================
FROM base AS comfyui

# Install ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI

WORKDIR /app/ComfyUI

# Install PyTorch + ComfyUI dependencies
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir -r requirements.txt

# Create model directories
RUN mkdir -p models/checkpoints models/vae models/loras models/embeddings

# Install FSampler custom node
RUN git clone https://github.com/obisin/ComfyUI-FSampler.git custom_nodes/ComfyUI-FSampler

# ==================== Models Stage ====================
FROM comfyui AS models

# Download SD 1.5 model (~4GB)
RUN echo "Downloading SD 1.5 model (~4GB)..." \
    && wget -q --show-progress -O models/checkpoints/v1-5-pruned-emaonly.safetensors \
        "https://huggingface.co/Comfy-Org/stable-diffusion-v1-5-archive/resolve/main/v1-5-pruned-emaonly.safetensors" \
    && echo "Model downloaded!" \
    && ls -lh models/checkpoints/

# ==================== Dependencies Stage ====================
FROM models AS dependencies

WORKDIR /app

# Install ALL pip dependencies (this layer is cached)
RUN pip install --no-cache-dir \
    websockets \
    msgpack \
    pillow \
    numpy \
    pyyaml \
    aiohttp \
    runpod \
    imagehash \
    scikit-image \
    diffusers \
    huggingface-hub \
    accelerate

# Create directories
RUN mkdir -p /app/output /app/logs /app/state /app/seeds /app/cache

# Set ownership
RUN chown -R dreamgen:dreamgen /app

# ==================== Final Base Image ====================
FROM dependencies AS final

USER dreamgen

# Environment variables
ENV COMFYUI_PATH=/app/ComfyUI
ENV PYTHONPATH=/app:/app/backend
ENV LOG_LEVEL=INFO

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "print('healthy')" || exit 1

# Expose ComfyUI port
EXPOSE 8188

# Default: just keep container running (for inspection)
CMD ["sleep", "infinity"]

