# Dream Window Cloud Dockerfile
# =============================
# Builds on top of dreamgen-base for FAST iteration.
# Only the backend code layer changes - no 4GB model download!
#
# Prerequisites:
#   docker pull luxiasl/dreamgen-base:latest
#   (or build it: docker build -f docker/Dockerfile.base -t luxiasl/dreamgen-base:latest .)
#
# Build:
#   docker build -f docker/Dockerfile.cloud -t luxiasl/dreamgen:latest .
#
# Push:
#   docker push luxiasl/dreamgen:latest

# ==================== Use Pre-built Base ====================
# This image contains: CUDA, Python, ComfyUI, SD 1.5 model, all pip dependencies
# It's ~4GB but rarely changes, so we don't rebuild it.
ARG BASE_IMAGE=luxiasl/dreamgen-base:latest
FROM ${BASE_IMAGE} AS base

# ==================== Code Layer (FAST - only this changes!) ====================
FROM base AS runtime

USER root

WORKDIR /app

# Copy backend code, prompts, and configs
COPY backend/ /app/backend/
COPY prompts/ /app/prompts/
COPY pyproject.toml /app/

# Note: Seeds removed - FreshFrameBuffer generates all bootstrap frames via txt2img

# Embed build info for debugging
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown
RUN echo "BUILD_DATE=${BUILD_DATE}" > /app/BUILD_INFO && \
    echo "GIT_COMMIT=${GIT_COMMIT}" >> /app/BUILD_INFO && \
    echo "Built: $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> /app/BUILD_INFO

# Set ownership
RUN chown -R dreamgen:dreamgen /app/backend /app/pyproject.toml

USER dreamgen

# Environment variables
ENV COMFYUI_PATH=/app/ComfyUI
ENV PYTHONPATH=/app:/app/backend
ENV LOG_LEVEL=INFO
ENV CONFIG_PATH=/app/backend/config.cloud.yaml

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "print('healthy')" || exit 1

# Expose ComfyUI port
EXPOSE 8188

# ==================== Development Stage (build with: --target dev) ====================
FROM runtime AS dev

USER root

# Install dev dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-asyncio \
    black \
    ruff

USER dreamgen

# Dev mode with local flag
CMD ["python", "-m", "backend.cloud.runpod_handler", "--local"]


# ==================== Production Stage (DEFAULT) ====================
# This MUST be the LAST stage so it's used by default
FROM runtime AS production

# Run the RunPod handler (no --local flag!)
CMD ["python", "-m", "backend.cloud.runpod_handler"]
