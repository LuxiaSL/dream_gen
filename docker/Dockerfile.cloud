# Dream Window Cloud Dockerfile
# 
# Optimized for RunPod Serverless with Flashboot:
# - Pre-baked ComfyUI with SD 1.5 model
# - All Python dependencies installed
# - Fast cold start (~30-60s)
#
# Build:
#   docker build -f docker/Dockerfile.cloud -t dream-window:cloud .
#
# Run locally:
#   docker run --gpus all -e VPS_WEBSOCKET_URL=ws://localhost:8000/ws/gpu dream-window:cloud
#
# Push to RunPod:
#   docker tag dream-window:cloud <your-registry>/dream-window:cloud
#   docker push <your-registry>/dream-window:cloud

# ==================== Base Stage ====================
FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    git \
    curl \
    wget \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Create app user for security
RUN useradd -m -s /bin/bash dreamgen
WORKDIR /app

# ==================== ComfyUI Stage ====================
FROM base AS comfyui

# Install ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI

WORKDIR /app/ComfyUI

# Install ComfyUI dependencies
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir -r requirements.txt

# Create model directories
RUN mkdir -p models/checkpoints models/vae models/loras models/embeddings

# ==================== Model Download Stage ====================
FROM comfyui AS models

# Download SD 1.5 model (or use a smaller model for testing)
# Note: For production, consider using a pre-downloaded model volume
ARG HF_TOKEN=""

# Download SD 1.5 checkpoint (dreamshaper for variety)
# Using wget with HuggingFace direct download
RUN if [ -n "$HF_TOKEN" ]; then \
        wget -q --header="Authorization: Bearer $HF_TOKEN" \
        -O models/checkpoints/dreamshaper_8.safetensors \
        "https://huggingface.co/Lykon/dreamshaper-8/resolve/main/dreamshaper_8.safetensors"; \
    else \
        echo "No HF_TOKEN provided, skipping model download"; \
        echo "Models will need to be mounted at runtime"; \
    fi

# ==================== Dream Gen Stage ====================
FROM models AS dreamgen

WORKDIR /app

# Copy dream_gen backend
COPY backend/ /app/backend/
COPY pyproject.toml /app/

# Install dream_gen dependencies
RUN pip install --no-cache-dir \
    websockets \
    msgpack \
    pillow \
    numpy \
    pyyaml \
    aiohttp \
    runpod

# Install additional cloud dependencies
RUN pip install --no-cache-dir \
    imagehash \
    scikit-image \
    diffusers \
    huggingface-hub

# Create directories
RUN mkdir -p /app/output /app/logs /app/state /app/seeds

# Copy seed images (if any)
COPY seeds/ /app/seeds/ 2>/dev/null || true

# Set ownership
RUN chown -R dreamgen:dreamgen /app

# ==================== Runtime Stage ====================
FROM dreamgen AS runtime

USER dreamgen

# Environment variables
ENV COMFYUI_PATH=/app/ComfyUI
ENV PYTHONPATH=/app
ENV LOG_LEVEL=INFO

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "print('healthy')" || exit 1

# Expose ComfyUI port (for debugging)
EXPOSE 8188

# Default command: Run the RunPod handler
CMD ["python", "-m", "backend.cloud.runpod_handler"]

# ==================== Development Stage ====================
FROM runtime AS dev

USER root

# Install dev dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-asyncio \
    black \
    ruff

USER dreamgen

# Development command: Run with live reload
CMD ["python", "-m", "backend.cloud.runpod_handler", "--local"]

